// apiDelete godoc
//
//	@Summary	Delete a [[.Lower]]
//	@Tags		[[.Table]]
//	@Param		id	path	int	true	"[[.Lower]] id"
//	@Success	204	"no content"
//	@Failure	404	{object}	map[string]any
//	@Router		/[[.Table]]/{id} [delete]
func (m *Module) apiDelete(c echo.Context) error {
	userID, _ := auth.UserID(c)
	id, err := parseID(c)
	if err != nil {
		return err
	}
	if err := m.svc.Delete(c.Request().Context(), userID, id); err != nil {
		return err
	}
	return c.NoContent(http.StatusNoContent)
}
