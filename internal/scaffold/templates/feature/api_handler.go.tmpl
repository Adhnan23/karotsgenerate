package [[.Lower]]

import (
	"net/http"

	"github.com/labstack/echo/v4"

	"[[.ModulePath]]/internal/features/auth"
)

// listResponse is the JSON shape for a paginated list.
type listResponse struct {
	Items   [][[.Title]]Response `json:"items"`
	Page    int                  `json:"page"`
	Size    int                  `json:"size"`
	Total   int                  `json:"total"`
	HasNext bool                 `json:"has_next"`
	HasPrev bool                 `json:"has_prev"`
}

// apiList godoc
//
//	@Summary	List the authenticated user's [[.Table]] (paginated)
//	@Tags		[[.Table]]
//	@Produce	json
//	@Param		page	query		int	false	"page number (1-based)"
//	@Param		size	query		int	false	"page size (max 100)"
//	@Success	200		{object}	listResponse
//	@Failure	401		{object}	map[string]any
//	@Router		/[[.Table]] [get]
func (m *Module) apiList(c echo.Context) error {
	userID, _ := auth.UserID(c)

	var params PageParams
	_ = c.Bind(&params)
	page, err := m.svc.List(c.Request().Context(), userID, params)
	if err != nil {
		return err
	}
	return c.JSON(http.StatusOK, listResponse{
		Items:   page.[[.Title]]Responses(),
		Page:    page.Page,
		Size:    page.Size,
		Total:   page.Total,
		HasNext: page.HasNext,
		HasPrev: page.HasPrev,
	})
}

// apiCreate godoc
//
//	@Summary	Create a [[.Lower]]
//	@Tags		[[.Table]]
//	@Accept		json
//	@Produce	json
//	@Param		body	body		Create[[.Title]]Request	true	"[[.Lower]]"
//	@Success	201		{object}	[[.Title]]Response
//	@Failure	400		{object}	map[string]any
//	@Failure	401		{object}	map[string]any
//	@Router		/[[.Table]] [post]
func (m *Module) apiCreate(c echo.Context) error {
	userID, _ := auth.UserID(c)

	var req Create[[.Title]]Request
	if err := c.Bind(&req); err != nil {
		return err
	}
	if err := c.Validate(&req); err != nil {
		return err
	}
	n, err := m.svc.Create(c.Request().Context(), userID, req.Title, req.Body)
	if err != nil {
		return err
	}
	return c.JSON(http.StatusCreated, n.ToResponse())
}

