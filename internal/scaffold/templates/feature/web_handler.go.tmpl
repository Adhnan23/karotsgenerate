package [[.Lower]]

import (
	"net/http"

	"github.com/labstack/echo/v4"

	"[[.ModulePath]]/internal/features/auth"
	"[[.ModulePath]]/internal/platform/render"
)

func (m *Module) webList(c echo.Context) error {
	userID, _ := auth.UserID(c)

	var params PageParams
	_ = c.Bind(&params) // binds ?page= & ?size= from the query string
	page, err := m.svc.List(c.Request().Context(), userID, params)
	if err != nil {
		return err
	}
	return render.Component(c, http.StatusOK, [[.TitlePlural]]Page(render.CSRFToken(c), auth.Email(c), page))
}

func (m *Module) webCreate(c echo.Context) error {
	userID, _ := auth.UserID(c)

	var req Create[[.Title]]Request
	_ = c.Bind(&req)
	if err := c.Validate(&req); err != nil {
		return err // central handler renders a 400; htmx leaves the list unchanged
	}
	n, err := m.svc.Create(c.Request().Context(), userID, req)
	if err != nil {
		return err
	}
	// Return just the new card; htmx prepends it to #[[.Lower]]-list.
	return render.Partial(c, [[.Title]]Item(n))
}

func (m *Module) webDelete(c echo.Context) error {
	userID, _ := auth.UserID(c)

	id, err := parseID(c)
	if err != nil {
		return err
	}
	if err := m.svc.Delete(c.Request().Context(), userID, id); err != nil {
		return err
	}
	// 200 with an empty body so htmx's outerHTML swap removes the card.
	return c.HTML(http.StatusOK, "")
}
