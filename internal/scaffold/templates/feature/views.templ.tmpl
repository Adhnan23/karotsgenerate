package [[.Lower]]

// Views colocated in the feature package so they can use [[.Title]]/Page directly. The
// list page renders the create form plus a paginated list; htmx swaps individual
// fragments (new item prepended, deleted item removed) without full page reloads.

import (
	"fmt"

	"[[.ModulePath]]/internal/shared/layout"
)

templ [[.TitlePlural]]Page(csrf, userEmail string, page Page) {
	@layout.Base("[[.TitlePlural]]", userEmail, csrf) {
		<h1>Your [[.Table]]</h1>
		@Create[[.Title]]Form(csrf)
		@[[.Title]]List(page.Items)
		@Pagination(page)
	}
}

// Create[[.Title]]Form posts to /[[.Table]]; on success the server returns a [[.Title]]Item
// which is prepended to #[[.Lower]]-list, and the form resets itself.
templ Create[[.Title]]Form(csrf string) {
	<form
		class="[[.Lower]]-form"
		hx-post="/[[.Table]]"
		hx-target="#[[.Lower]]-list"
		hx-swap="afterbegin"
		hx-on::after-request="if(event.detail.successful) { this.reset(); this.dispatchEvent(new Event('reset-counter')); }"
	>
		<input type="hidden" name="_csrf" value={ csrf }/>
		<input type="text" name="title" placeholder="Title" maxlength="200" required/>
		<!-- Alpine handles the purely-local character counter; the server never needs
		     to know about it. htmx handles the actual submit/swap. -->
		<div x-data="{ count: 0 }" x-on:reset-counter="count = 0">
			<textarea
				name="body"
				placeholder="Write something…"
				rows="3"
				maxlength="10000"
				x-on:input="count = $event.target.value.length"
			></textarea>
			<p class="counter"><span x-text="count"></span> / 10000</p>
		</div>
		<button type="submit">Add</button>
	</form>
}

// [[.Title]]List is the container fragment (also targeted on create).
templ [[.Title]]List(items [][[.Title]]) {
	<div id="[[.Lower]]-list" class="[[.Lower]]-list">
		if len(items) == 0 {
			<p class="muted" id="empty-state">Nothing yet. Add your first above.</p>
		}
		for _, n := range items {
			@[[.Title]]Item(n)
		}
	</div>
}

// [[.Title]]Item is one card with a delete button. Deleting swaps the card's own outer
// HTML with the server's empty response, removing it from the DOM.
templ [[.Title]]Item(n [[.Title]]) {
	<article class="[[.Lower]]" id={ fmt.Sprintf("[[.Lower]]-%d", n.ID) }>
		<h3>{ n.Title }</h3>
		if n.Body != "" {
			<p>{ n.Body }</p>
		}
		<footer>
			<time>{ n.CreatedAt.Format("2006-01-02 15:04") }</time>
			<button
				class="link danger"
				hx-delete={ fmt.Sprintf("/[[.Table]]/%d", n.ID) }
				hx-target={ fmt.Sprintf("#[[.Lower]]-%d", n.ID) }
				hx-swap="outerHTML"
				hx-confirm="Delete this?"
			>Delete</button>
		</footer>
	</article>
}

// Pagination renders prev/next controls when there's more than one page.
templ Pagination(p Page) {
	if p.HasPrev || p.HasNext {
		<nav class="pagination">
			if p.HasPrev {
				<a href={ templ.SafeURL(fmt.Sprintf("/[[.Table]]?page=%d&size=%d", p.Page-1, p.Size)) }>← Prev</a>
			}
			<span>Page { fmt.Sprintf("%d", p.Page) }</span>
			if p.HasNext {
				<a href={ templ.SafeURL(fmt.Sprintf("/[[.Table]]?page=%d&size=%d", p.Page+1, p.Size)) }>Next →</a>
			}
		</nav>
	}
}
