package [[.Lower]]

import (
	"context"
	"database/sql"
	"errors"

	"[[.ModulePath]]/internal/platform/apperr"
)

// Service holds [[.Lower]] business logic, including ownership enforcement. It depends
// on the Repository interface, so it's unit-testable with a mock.
type Service struct {
	repo Repository
}

// NewService wires the service.
func NewService(repo Repository) *Service {
	return &Service{repo: repo}
}

// Create makes a new [[.Lower]] owned by userID.
func (s *Service) Create(ctx context.Context, userID int64, in Create[[.Title]]Request) ([[.Title]], error) {
	n, err := s.repo.Create(ctx, userID, in)
	if err != nil {
		return [[.Title]]{}, apperr.Internal("could not create [[.Lower]]", err)
	}
	return n, nil
}

// Get returns a [[.Lower]] the user owns. One owned by someone else is reported as
// NotFound (not Forbidden) so we don't reveal that the id exists.
func (s *Service) Get(ctx context.Context, userID, id int64) ([[.Title]], error) {
	return s.owned(ctx, userID, id)
}

// List returns a page of the user's [[.Table]] plus pagination metadata.
func (s *Service) List(ctx context.Context, userID int64, params PageParams) (Page, error) {
	params = params.Normalize()

	total, err := s.repo.CountByUser(ctx, userID)
	if err != nil {
		return Page{}, apperr.Internal("could not count [[.Table]]", err)
	}
	items, err := s.repo.ListByUser(ctx, userID, params.Limit(), params.Offset())
	if err != nil {
		return Page{}, apperr.Internal("could not list [[.Table]]", err)
	}
	return Page{
		Items:   items,
		Page:    params.Page,
		Size:    params.Size,
		Total:   total,
		HasNext: params.Offset()+len(items) < total,
		HasPrev: params.Page > 1,
	}, nil
}

// Update changes a [[.Lower]] the user owns.
func (s *Service) Update(ctx context.Context, userID, id int64, in Update[[.Title]]Request) ([[.Title]], error) {
	if _, err := s.owned(ctx, userID, id); err != nil {
		return [[.Title]]{}, err
	}
	n, err := s.repo.Update(ctx, id, in)
	if err != nil {
		return [[.Title]]{}, apperr.Internal("could not update [[.Lower]]", err)
	}
	return n, nil
}

// Delete removes a [[.Lower]] the user owns.
func (s *Service) Delete(ctx context.Context, userID, id int64) error {
	if _, err := s.owned(ctx, userID, id); err != nil {
		return err
	}
	if err := s.repo.Delete(ctx, id); err != nil {
		return apperr.Internal("could not delete [[.Lower]]", err)
	}
	return nil
}

// owned loads a [[.Lower]] and verifies ownership, centralizing the not-found /
// not-yours logic so every mutating method enforces it identically.
func (s *Service) owned(ctx context.Context, userID, id int64) ([[.Title]], error) {
	n, err := s.repo.GetByID(ctx, id)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return [[.Title]]{}, apperr.NotFound("[[.Lower]] not found")
		}
		return [[.Title]]{}, apperr.Internal("could not load [[.Lower]]", err)
	}
	if n.UserID != userID {
		return [[.Title]]{}, apperr.NotFound("[[.Lower]] not found")
	}
	return n, nil
}
