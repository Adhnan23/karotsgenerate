package database

import (
	"context"
	"fmt"

	"github.com/jmoiron/sqlx"
	"github.com/pressly/goose/v3"

	"[[.ModulePath]]/migrations"
)

// Migrate applies all pending up migrations using the embedded SQL files.
// Running this on startup keeps dev/prod in sync without a separate deploy step;
// goose records applied versions in its own goose_db_version table, so re-running
// is a no-op once everything is applied.
func Migrate(ctx context.Context, db *sqlx.DB) error {
	goose.SetBaseFS(migrations.FS) // read migrations from the embedded FS, not disk
	if err := goose.SetDialect("postgres"); err != nil {
		return fmt.Errorf("set goose dialect: %w", err)
	}
	// "." is the root of the embedded FS (the migrations package directory).
	if err := goose.UpContext(ctx, db.DB, "."); err != nil {
		return fmt.Errorf("run migrations: %w", err)
	}
	return nil
}
