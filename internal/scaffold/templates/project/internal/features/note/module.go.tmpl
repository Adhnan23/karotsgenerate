// Package note is a self-contained feature: per-user note CRUD over both a web (htmx)
// surface and a JSON API surface that share one Service. Its routes are protected by
// auth middleware passed in from main.go — the one deliberate cross-feature link.
package note

import (
	"log/slog"

	"github.com/jmoiron/sqlx"
	"github.com/labstack/echo/v4"
)

// Module bundles the feature's dependencies and registers its routes. The two guard
// middlewares come from the auth feature (RequireAuth for API, RequireAuthWeb for the
// browser) and are injected rather than imported as a hard dependency on auth.Module.
type Module struct {
	svc      *Service
	logger   *slog.Logger
	apiGuard echo.MiddlewareFunc
	webGuard echo.MiddlewareFunc
}

// NewModule constructs the note feature.
func NewModule(logger *slog.Logger, db *sqlx.DB, apiGuard, webGuard echo.MiddlewareFunc) *Module {
	return &Module{
		svc:      NewService(NewRepository(db)),
		logger:   logger,
		apiGuard: apiGuard,
		webGuard: webGuard,
	}
}

// Mount registers the web and API routes, each behind the appropriate auth guard.
func (m *Module) Mount(root *echo.Group) {
	web := root.Group("/notes", m.webGuard)
	web.GET("", m.webList)
	web.POST("", m.webCreate)
	web.DELETE("/:id", m.webDelete)

	api := root.Group("/api/v1/notes", m.apiGuard)
	api.GET("", m.apiList)
	api.POST("", m.apiCreate)
	api.GET("/:id", m.apiGet)
	api.PUT("/:id", m.apiUpdate)
	api.DELETE("/:id", m.apiDelete)
}
