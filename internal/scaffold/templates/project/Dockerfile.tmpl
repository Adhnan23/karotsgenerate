# Multi-stage build producing a single static binary with everything embedded
# (migrations, templates-as-Go, static assets, swagger docs).

# ---- build stage ----
FROM golang:1.26-alpine AS build
WORKDIR /src

# Tools needed for codegen at build time.
RUN go install github.com/a-h/templ/cmd/templ@latest \
 && go install github.com/swaggo/swag/cmd/swag@latest

# Cache deps first.
COPY go.mod go.sum* ./
RUN go mod download

COPY . .

# Generate templ Go + swagger spec, then build.
RUN templ generate \
 && swag init -g cmd/web/main.go -o docs/swagger --parseInternal \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/web ./cmd/web

# ---- run stage ----
FROM alpine:3.20
RUN adduser -D -u 10001 app
COPY --from=build /out/web /usr/local/bin/web
USER app
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/web"]
