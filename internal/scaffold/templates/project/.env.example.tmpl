# Copy to .env and adjust. Loaded by the app at startup (see internal/platform/config).

# --- HTTP server ---
APP_ENV=development          # development | production (controls log format, cookie Secure flag)
APP_PORT=[[.AppPort]]
APP_BASE_URL=http://localhost:[[.AppPort]]

# --- Database (Postgres) ---
# Used by the app AND by goose/Makefile. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://app:app@localhost:[[.DBPort]]/[[.DBName]]?sslmode=disable

# Separate DB URL used by integration tests (make test-integration).
TEST_DATABASE_URL=postgres://app:app@localhost:[[.DBPort]]/[[.DBName]]_test?sslmode=disable

# --- Auth / JWT ---
# CHANGE THIS in production. Used to sign access & refresh tokens.
JWT_SECRET=[[.JWTSecret]]
ACCESS_TOKEN_TTL=15m         # short-lived access token
REFRESH_TOKEN_TTL=168h       # 7 days refresh token

# --- Rate limiting ---
AUTH_RATE_LIMIT=10           # requests per minute per IP on /auth/* and /api/v1/auth/*
